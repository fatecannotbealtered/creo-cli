{
  "command": "model export",
  "rows": [
    {
      "row": "normal",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--output",
        "{dir}/block.stp"
      ],
      "expected": {
        "exit": 0
      }
    },
    {
      "row": "empty",
      "applies": false,
      "reason": "Every export writes a file; there is no empty export."
    },
    {
      "row": "invalid_input",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}"
      ],
      "expected": {
        "exit": 2,
        "code": "E_USAGE",
        "summary": "--output is missing."
      }
    },
    {
      "row": "not_found",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "not-open",
        "--output",
        "{dir}/block.stp"
      ],
      "expected": {
        "exit": 3,
        "code": "E_NOT_FOUND"
      }
    },
    {
      "row": "ambiguous",
      "applies": true,
      "arguments": [
        "--output",
        "{dir}/block.stp"
      ],
      "expected": {
        "exit": 2,
        "code": "E_AMBIGUOUS",
        "summary": "Two Creo sessions are running and the call names neither."
      }
    },
    {
      "row": "conflict",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--output",
        "{dir}/block.stp"
      ],
      "expected": {
        "exit": 6,
        "code": "E_CONFLICT",
        "summary": "A newer version of the document's file is on disk (disk: changed)."
      }
    },
    {
      "row": "no_scope",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--output",
        "{dir}/block.stp"
      ],
      "expected": {
        "exit": 4,
        "code": "E_FORBIDDEN",
        "summary": "Run with a scope file that does not cover the document."
      }
    },
    {
      "row": "busy",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--output",
        "{dir}/block.stp"
      ],
      "expected": {
        "exit": 7,
        "code": "E_BUSY",
        "summary": "Creo's main thread is running another request."
      }
    },
    {
      "row": "dialog",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--output",
        "{dir}/block.stp"
      ],
      "expected": {
        "exit": 9,
        "code": "E_HUMAN_REQUIRED",
        "summary": "A modal dialog (File > Options) is open in Creo."
      }
    },
    {
      "row": "disconnect",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--output",
        "{dir}/block.stp"
      ],
      "expected": {
        "exit": 8,
        "code": "E_OUTCOME_UNKNOWN"
      },
      "unrunnable": "The pipe to the host component cannot be cut on demand at the moment of a call; driver tests D06 and D21 cover this case."
    },
    {
      "row": "unsaved",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--output",
        "{dir}/block.stp"
      ],
      "expected": {
        "exit": 0,
        "summary": "Works the same on a document with unsaved changes: run after any unsaved change to the document."
      }
    },
    {
      "row": "read_back_mismatch",
      "applies": false,
      "reason": "An artifact's read-back checks the file the command wrote: it exists, and its size and SHA-256 are recorded. No stored value can differ from the preview, so a mismatch cannot happen."
    }
  ]
}
