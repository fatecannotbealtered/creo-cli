{
  "command": "model update",
  "rows": [
    {
      "row": "normal",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--material",
        "ABS",
        "--common-name",
        "PS4 TOP"
      ],
      "expected": {
        "exit": 0,
        "summary": "Assigns ABS from Creo's material library and sets the common name PS4 TOP."
      }
    },
    {
      "row": "empty",
      "applies": false,
      "reason": "The command always sets what it is given."
    },
    {
      "row": "invalid_input",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}"
      ],
      "expected": {
        "exit": 3,
        "code": "E_VALIDATION",
        "summary": "Neither --material nor --common-name is given."
      }
    },
    {
      "row": "not_found",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--material",
        "NOSUCH"
      ],
      "expected": {
        "exit": 3,
        "code": "E_NOT_FOUND",
        "summary": "No material NOSUCH is in the part or the library."
      }
    },
    {
      "row": "ambiguous",
      "applies": true,
      "arguments": [
        "--material",
        "ABS",
        "--common-name",
        "PS4 TOP"
      ],
      "expected": {
        "exit": 2,
        "code": "E_AMBIGUOUS",
        "summary": "Two Creo sessions are running and the call names neither."
      }
    },
    {
      "row": "conflict",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--material",
        "ABS",
        "--common-name",
        "PS4 TOP"
      ],
      "expected": {
        "exit": 6,
        "code": "E_CONFLICT",
        "summary": "On a model whose common name a PDM system manages: the preview blocks it."
      },
      "unrunnable": "No PDM-managed model is in the authorized folder; the preview check is covered by review."
    },
    {
      "row": "no_scope",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--material",
        "ABS",
        "--common-name",
        "PS4 TOP"
      ],
      "expected": {
        "exit": 4,
        "code": "E_FORBIDDEN",
        "summary": "Run with a scope file that does not cover the document."
      }
    },
    {
      "row": "busy",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--material",
        "ABS",
        "--common-name",
        "PS4 TOP"
      ],
      "expected": {
        "exit": 7,
        "code": "E_BUSY",
        "summary": "Creo's main thread is running another request."
      }
    },
    {
      "row": "dialog",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--material",
        "ABS",
        "--common-name",
        "PS4 TOP"
      ],
      "expected": {
        "exit": 9,
        "code": "E_HUMAN_REQUIRED",
        "summary": "A modal dialog (File > Options) is open in Creo."
      }
    },
    {
      "row": "disconnect",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--material",
        "ABS",
        "--common-name",
        "PS4 TOP"
      ],
      "expected": {
        "exit": 8,
        "code": "E_OUTCOME_UNKNOWN"
      },
      "unrunnable": "The pipe to the host component cannot be cut on demand at the moment of a call; driver tests D06 and D21 cover this case."
    },
    {
      "row": "unsaved",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--material",
        "ABS",
        "--common-name",
        "PS4 TOP"
      ],
      "expected": {
        "exit": 0,
        "summary": "Works the same on a document with unsaved changes; the change stays unsaved until doc save."
      }
    },
    {
      "row": "read_back_mismatch",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--material",
        "ABS",
        "--common-name",
        "PS4 TOP"
      ],
      "expected": {
        "exit": 1,
        "code": "E_VERIFY_FAILED",
        "summary": "While the tool waits before its read-back, --tamper assigns another material in Creo."
      }
    }
  ]
}
