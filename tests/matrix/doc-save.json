{
  "command": "doc save",
  "rows": [
    {
      "row": "normal",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}"
      ],
      "expected": {
        "exit": 0,
        "summary": "Two-step, confirmed with its token: saves the changes since the last save, and the read-back finds them with `saved: true`."
      }
    },
    {
      "row": "empty",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}"
      ],
      "expected": {
        "exit": 0,
        "summary": "A clean document, confirmed with its token: Creo writes a new version; the preview lists no change."
      }
    },
    {
      "row": "invalid_input",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--bogus"
      ],
      "expected": {
        "exit": 2,
        "code": "E_USAGE"
      }
    },
    {
      "row": "not_found",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "not-open"
      ],
      "expected": {
        "exit": 3,
        "code": "E_NOT_FOUND",
        "summary": "No document not-open is open in the session."
      }
    },
    {
      "row": "ambiguous",
      "applies": true,
      "arguments": [
        "--doc",
        "{doc}"
      ],
      "expected": {
        "exit": 2,
        "code": "E_AMBIGUOUS",
        "summary": "Two Creo sessions are running and the call names neither."
      }
    },
    {
      "row": "conflict",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}"
      ],
      "expected": {
        "exit": 6,
        "code": "E_CONFLICT",
        "summary": "A newer version of the document's file is on disk (disk: changed)."
      }
    },
    {
      "row": "no_scope",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}"
      ],
      "expected": {
        "exit": 4,
        "code": "E_FORBIDDEN",
        "summary": "Run with a scope file that does not cover the document."
      }
    },
    {
      "row": "busy",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}"
      ],
      "expected": {
        "exit": 7,
        "code": "E_BUSY",
        "summary": "Creo's main thread is running another request."
      }
    },
    {
      "row": "dialog",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}"
      ],
      "expected": {
        "exit": 9,
        "code": "E_HUMAN_REQUIRED",
        "summary": "A modal dialog (File > Options) is open in Creo."
      }
    },
    {
      "row": "disconnect",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}"
      ],
      "expected": {
        "exit": 8,
        "code": "E_OUTCOME_UNKNOWN"
      },
      "unrunnable": "The pipe to the host component cannot be cut on demand at the moment of a call; driver tests D06 and D21 cover this case."
    },
    {
      "row": "unsaved",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}"
      ],
      "expected": {
        "exit": 0,
        "summary": "Confirmed with its token: saves the unsaved changes the preview lists."
      }
    },
    {
      "row": "read_back_mismatch",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}"
      ],
      "expected": {
        "exit": 1,
        "code": "E_VERIFY_FAILED",
        "summary": "After an unsaved dimension change: while the tool waits before its read-back, --tamper deletes the version file the save wrote, so `saved` is false."
      }
    }
  ]
}
