{
  "command": "parameter update",
  "rows": [
    {
      "row": "normal",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--id",
        "PART_CODE",
        "--value",
        "DSC-002"
      ],
      "expected": {
        "exit": 0
      }
    },
    {
      "row": "empty",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--id",
        "PART_CODE",
        "--value",
        "DSC-002"
      ],
      "expected": {
        "exit": 0,
        "summary": "PART_CODE is already DSC-002: nothing changes."
      }
    },
    {
      "row": "invalid_input",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--id",
        "PART_CODE"
      ],
      "expected": {
        "exit": 2,
        "code": "E_USAGE",
        "summary": "--value is missing."
      }
    },
    {
      "row": "not_found",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--id",
        "NOSUCH",
        "--value",
        "1"
      ],
      "expected": {
        "exit": 3,
        "code": "E_NOT_FOUND"
      }
    },
    {
      "row": "ambiguous",
      "applies": true,
      "arguments": [
        "--id",
        "PART_CODE",
        "--value",
        "DSC-002"
      ],
      "expected": {
        "exit": 2,
        "code": "E_AMBIGUOUS",
        "summary": "Two Creo sessions are running and the call names neither."
      }
    },
    {
      "row": "conflict",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--id",
        "HALF_DIAMETER",
        "--value",
        "5"
      ],
      "expected": {
        "exit": 6,
        "code": "E_CONFLICT",
        "summary": "HALF_DIAMETER is driven by the relation HALF_DIAMETER = DIAMETER / 2."
      }
    },
    {
      "row": "no_scope",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--id",
        "PART_CODE",
        "--value",
        "DSC-002"
      ],
      "expected": {
        "exit": 4,
        "code": "E_FORBIDDEN",
        "summary": "Run with a scope file that does not cover the document."
      }
    },
    {
      "row": "busy",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--id",
        "PART_CODE",
        "--value",
        "DSC-002"
      ],
      "expected": {
        "exit": 7,
        "code": "E_BUSY",
        "summary": "Creo's main thread is running another request."
      }
    },
    {
      "row": "dialog",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--id",
        "PART_CODE",
        "--value",
        "DSC-002"
      ],
      "expected": {
        "exit": 9,
        "code": "E_HUMAN_REQUIRED",
        "summary": "A modal dialog (File > Options) is open in Creo."
      }
    },
    {
      "row": "disconnect",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--id",
        "PART_CODE",
        "--value",
        "DSC-002"
      ],
      "expected": {
        "exit": 8,
        "code": "E_OUTCOME_UNKNOWN"
      },
      "unrunnable": "The pipe to the host component cannot be cut on demand at the moment of a call; driver tests D06 and D21 cover this case."
    },
    {
      "row": "unsaved",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--id",
        "PART_CODE",
        "--value",
        "DSC-002"
      ],
      "expected": {
        "exit": 0,
        "summary": "Works the same on a document with unsaved changes: run after any unsaved change to the document."
      }
    },
    {
      "row": "read_back_mismatch",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--id",
        "PART_CODE",
        "--value",
        "DSC-003"
      ],
      "expected": {
        "exit": 1,
        "code": "E_VERIFY_FAILED",
        "summary": "Prepared live: a situation in which Creo stores another value than the one given."
      }
    }
  ]
}
