{
  "command": "round create",
  "rows": [
    {
      "row": "normal",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "TOP_ROUND",
        "--radius",
        "2mm",
        "--radius-name",
        "TOP_R",
        "--edges",
        "BASE/end:outer-edges"
      ],
      "expected": {
        "exit": 0,
        "summary": "On a part with the extrude BASE: rounds the outer edges of BASE's end face to R2; the radius is named TOP_R."
      }
    },
    {
      "row": "empty",
      "applies": false,
      "reason": "Creating always gives one feature."
    },
    {
      "row": "invalid_input",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "TOP_ROUND",
        "--radius",
        "2",
        "--edges",
        "BASE/end:outer-edges"
      ],
      "expected": {
        "exit": 2,
        "code": "E_USAGE",
        "summary": "A bare number: the value needs a unit."
      }
    },
    {
      "row": "not_found",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "TOP_ROUND",
        "--radius",
        "2mm",
        "--edges",
        "NOSUCH/end:edges"
      ],
      "expected": {
        "exit": 3,
        "code": "E_NOT_FOUND",
        "summary": "The named feature face does not exist."
      }
    },
    {
      "row": "ambiguous",
      "applies": true,
      "arguments": [
        "--name",
        "TOP_ROUND",
        "--radius",
        "2mm",
        "--radius-name",
        "TOP_R",
        "--edges",
        "BASE/end:outer-edges"
      ],
      "expected": {
        "exit": 2,
        "code": "E_AMBIGUOUS",
        "summary": "Two Creo sessions are running and the call names neither."
      }
    },
    {
      "row": "conflict",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "TOP_ROUND",
        "--radius",
        "2mm",
        "--radius-name",
        "TOP_R",
        "--edges",
        "BASE/end:outer-edges"
      ],
      "expected": {
        "exit": 6,
        "code": "E_CONFLICT",
        "summary": "A feature named TOP_ROUND exists: the preview blocks it."
      }
    },
    {
      "row": "no_scope",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "TOP_ROUND",
        "--radius",
        "2mm",
        "--radius-name",
        "TOP_R",
        "--edges",
        "BASE/end:outer-edges"
      ],
      "expected": {
        "exit": 4,
        "code": "E_FORBIDDEN",
        "summary": "Run with a scope file that does not cover the document."
      }
    },
    {
      "row": "busy",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "TOP_ROUND",
        "--radius",
        "2mm",
        "--radius-name",
        "TOP_R",
        "--edges",
        "BASE/end:outer-edges"
      ],
      "expected": {
        "exit": 7,
        "code": "E_BUSY",
        "summary": "Creo's main thread is running another request."
      }
    },
    {
      "row": "dialog",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "TOP_ROUND",
        "--radius",
        "2mm",
        "--radius-name",
        "TOP_R",
        "--edges",
        "BASE/end:outer-edges"
      ],
      "expected": {
        "exit": 9,
        "code": "E_HUMAN_REQUIRED",
        "summary": "A modal dialog (File > Options) is open in Creo."
      }
    },
    {
      "row": "disconnect",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "TOP_ROUND",
        "--radius",
        "2mm",
        "--radius-name",
        "TOP_R",
        "--edges",
        "BASE/end:outer-edges"
      ],
      "expected": {
        "exit": 8,
        "code": "E_OUTCOME_UNKNOWN"
      },
      "unrunnable": "The pipe to the host component cannot be cut on demand at the moment of a call; driver tests D06 and D21 cover this case."
    },
    {
      "row": "unsaved",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "TOP_ROUND",
        "--radius",
        "2mm",
        "--radius-name",
        "TOP_R",
        "--edges",
        "BASE/end:outer-edges"
      ],
      "expected": {
        "exit": 0,
        "summary": "Works the same on a document with unsaved changes; the new feature stays unsaved until doc save."
      }
    },
    {
      "row": "read_back_mismatch",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "TOP_ROUND",
        "--radius",
        "2mm",
        "--radius-name",
        "TOP_R",
        "--edges",
        "BASE/end:outer-edges"
      ],
      "expected": {
        "exit": 1,
        "code": "E_VERIFY_FAILED",
        "summary": "While the tool waits before its read-back, --tamper sets TOP_R to another value in Creo."
      }
    }
  ]
}
