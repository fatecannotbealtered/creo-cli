{
  "command": "shell create",
  "rows": [
    {
      "row": "normal",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "SHELL",
        "--thickness",
        "2mm",
        "--thickness-name",
        "WALL",
        "--remove",
        "BASE/start"
      ],
      "expected": {
        "exit": 0,
        "summary": "On a part with the extrude BASE: hollows it with 2 mm walls, open at BASE's start face; the thickness is named WALL."
      }
    },
    {
      "row": "empty",
      "applies": false,
      "reason": "Creating always gives one feature."
    },
    {
      "row": "invalid_input",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "SHELL",
        "--thickness",
        "2",
        "--remove",
        "BASE/start"
      ],
      "expected": {
        "exit": 2,
        "code": "E_USAGE",
        "summary": "A bare number: the value needs a unit."
      }
    },
    {
      "row": "not_found",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "SHELL",
        "--thickness",
        "2mm",
        "--remove",
        "NOSUCH/start"
      ],
      "expected": {
        "exit": 3,
        "code": "E_NOT_FOUND",
        "summary": "The named feature face does not exist."
      }
    },
    {
      "row": "ambiguous",
      "applies": true,
      "arguments": [
        "--name",
        "SHELL",
        "--thickness",
        "2mm",
        "--thickness-name",
        "WALL",
        "--remove",
        "BASE/start"
      ],
      "expected": {
        "exit": 2,
        "code": "E_AMBIGUOUS",
        "summary": "Two Creo sessions are running and the call names neither."
      }
    },
    {
      "row": "conflict",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "SHELL",
        "--thickness",
        "2mm",
        "--thickness-name",
        "WALL",
        "--remove",
        "BASE/start"
      ],
      "expected": {
        "exit": 6,
        "code": "E_CONFLICT",
        "summary": "A feature named SHELL exists: the preview blocks it."
      }
    },
    {
      "row": "no_scope",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "SHELL",
        "--thickness",
        "2mm",
        "--thickness-name",
        "WALL",
        "--remove",
        "BASE/start"
      ],
      "expected": {
        "exit": 4,
        "code": "E_FORBIDDEN",
        "summary": "Run with a scope file that does not cover the document."
      }
    },
    {
      "row": "busy",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "SHELL",
        "--thickness",
        "2mm",
        "--thickness-name",
        "WALL",
        "--remove",
        "BASE/start"
      ],
      "expected": {
        "exit": 7,
        "code": "E_BUSY",
        "summary": "Creo's main thread is running another request."
      }
    },
    {
      "row": "dialog",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "SHELL",
        "--thickness",
        "2mm",
        "--thickness-name",
        "WALL",
        "--remove",
        "BASE/start"
      ],
      "expected": {
        "exit": 9,
        "code": "E_HUMAN_REQUIRED",
        "summary": "A modal dialog (File > Options) is open in Creo."
      }
    },
    {
      "row": "disconnect",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "SHELL",
        "--thickness",
        "2mm",
        "--thickness-name",
        "WALL",
        "--remove",
        "BASE/start"
      ],
      "expected": {
        "exit": 8,
        "code": "E_OUTCOME_UNKNOWN"
      },
      "unrunnable": "The pipe to the host component cannot be cut on demand at the moment of a call; driver tests D06 and D21 cover this case."
    },
    {
      "row": "unsaved",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "SHELL",
        "--thickness",
        "2mm",
        "--thickness-name",
        "WALL",
        "--remove",
        "BASE/start"
      ],
      "expected": {
        "exit": 0,
        "summary": "Works the same on a document with unsaved changes; the new feature stays unsaved until doc save."
      }
    },
    {
      "row": "read_back_mismatch",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "SHELL",
        "--thickness",
        "2mm",
        "--thickness-name",
        "WALL",
        "--remove",
        "BASE/start"
      ],
      "expected": {
        "exit": 1,
        "code": "E_VERIFY_FAILED",
        "summary": "While the tool waits before its read-back, --tamper sets WALL to another value in Creo."
      }
    }
  ]
}
