{
  "command": "parameter create",
  "rows": [
    {
      "row": "normal",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "POSITIONS",
        "--type",
        "integer",
        "--value",
        "4"
      ],
      "expected": {
        "exit": 0,
        "summary": "Creates the integer parameter POSITIONS = 4."
      }
    },
    {
      "row": "empty",
      "applies": false,
      "reason": "Creating always gives one parameter."
    },
    {
      "row": "invalid_input",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "POSITIONS",
        "--type",
        "integer",
        "--value",
        "four"
      ],
      "expected": {
        "exit": 3,
        "code": "E_VALIDATION",
        "summary": "four is not an integer."
      }
    },
    {
      "row": "not_found",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "missing.prt",
        "--name",
        "POSITIONS",
        "--value",
        "4"
      ],
      "expected": {
        "exit": 3,
        "code": "E_NOT_FOUND",
        "summary": "No document of that name is open."
      }
    },
    {
      "row": "ambiguous",
      "applies": true,
      "arguments": [
        "--name",
        "POSITIONS",
        "--type",
        "integer",
        "--value",
        "4"
      ],
      "expected": {
        "exit": 2,
        "code": "E_AMBIGUOUS",
        "summary": "Two Creo sessions are running and the call names neither."
      }
    },
    {
      "row": "conflict",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "POSITIONS",
        "--type",
        "integer",
        "--value",
        "4"
      ],
      "expected": {
        "exit": 6,
        "code": "E_CONFLICT",
        "summary": "A parameter named POSITIONS exists: the preview blocks it."
      }
    },
    {
      "row": "no_scope",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "POSITIONS",
        "--type",
        "integer",
        "--value",
        "4"
      ],
      "expected": {
        "exit": 4,
        "code": "E_FORBIDDEN",
        "summary": "Run with a scope file that does not cover the document."
      }
    },
    {
      "row": "busy",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "POSITIONS",
        "--type",
        "integer",
        "--value",
        "4"
      ],
      "expected": {
        "exit": 7,
        "code": "E_BUSY",
        "summary": "Creo's main thread is running another request."
      }
    },
    {
      "row": "dialog",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "POSITIONS",
        "--type",
        "integer",
        "--value",
        "4"
      ],
      "expected": {
        "exit": 9,
        "code": "E_HUMAN_REQUIRED",
        "summary": "A modal dialog (File > Options) is open in Creo."
      }
    },
    {
      "row": "disconnect",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "POSITIONS",
        "--type",
        "integer",
        "--value",
        "4"
      ],
      "expected": {
        "exit": 8,
        "code": "E_OUTCOME_UNKNOWN"
      },
      "unrunnable": "The pipe to the host component cannot be cut on demand at the moment of a call; driver tests D06 and D21 cover this case."
    },
    {
      "row": "unsaved",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "POSITIONS",
        "--type",
        "integer",
        "--value",
        "4"
      ],
      "expected": {
        "exit": 0,
        "summary": "Works the same on a document with unsaved changes; the change stays unsaved until doc save."
      }
    },
    {
      "row": "read_back_mismatch",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "POSITIONS",
        "--type",
        "integer",
        "--value",
        "4"
      ],
      "expected": {
        "exit": 1,
        "code": "E_VERIFY_FAILED",
        "summary": "While the tool waits before its read-back, --tamper sets POSITIONS to another value in Creo."
      }
    }
  ]
}
