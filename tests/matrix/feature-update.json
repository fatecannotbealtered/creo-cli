{
  "command": "feature update",
  "rows": [
    {
      "row": "normal",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--id",
        "DTM_OFFSET",
        "--status",
        "suppressed"
      ],
      "expected": {
        "exit": 0
      }
    },
    {
      "row": "empty",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--id",
        "DTM_OFFSET",
        "--status",
        "suppressed"
      ],
      "expected": {
        "exit": 0,
        "summary": "DTM_OFFSET is already suppressed: nothing changes."
      }
    },
    {
      "row": "invalid_input",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--status",
        "suppressed"
      ],
      "expected": {
        "exit": 2,
        "code": "E_USAGE",
        "summary": "--id is missing."
      }
    },
    {
      "row": "not_found",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--id",
        "99999",
        "--status",
        "suppressed"
      ],
      "expected": {
        "exit": 3,
        "code": "E_NOT_FOUND"
      }
    },
    {
      "row": "ambiguous",
      "applies": true,
      "arguments": [
        "--id",
        "EDGE_ROUND",
        "--status",
        "suppressed"
      ],
      "expected": {
        "exit": 2,
        "code": "E_AMBIGUOUS",
        "summary": "Two Creo sessions are running and the call names neither."
      }
    },
    {
      "row": "conflict",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--id",
        "EDGE_ROUND",
        "--name",
        "BASE"
      ],
      "expected": {
        "exit": 6,
        "code": "E_CONFLICT",
        "summary": "Another feature is already named BASE."
      }
    },
    {
      "row": "no_scope",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--id",
        "EDGE_ROUND",
        "--status",
        "suppressed"
      ],
      "expected": {
        "exit": 4,
        "code": "E_FORBIDDEN",
        "summary": "Run with a scope file that does not cover the document."
      }
    },
    {
      "row": "busy",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--id",
        "EDGE_ROUND",
        "--status",
        "suppressed"
      ],
      "expected": {
        "exit": 7,
        "code": "E_BUSY",
        "summary": "Creo's main thread is running another request."
      }
    },
    {
      "row": "dialog",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--id",
        "EDGE_ROUND",
        "--status",
        "suppressed"
      ],
      "expected": {
        "exit": 9,
        "code": "E_HUMAN_REQUIRED",
        "summary": "A modal dialog (File > Options) is open in Creo."
      }
    },
    {
      "row": "disconnect",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--id",
        "EDGE_ROUND",
        "--status",
        "suppressed"
      ],
      "expected": {
        "exit": 8,
        "code": "E_OUTCOME_UNKNOWN"
      },
      "unrunnable": "The pipe to the host component cannot be cut on demand at the moment of a call; driver tests D06 and D21 cover this case."
    },
    {
      "row": "unsaved",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--id",
        "EDGE_ROUND",
        "--status",
        "suppressed"
      ],
      "expected": {
        "exit": 0,
        "summary": "Works the same on a document with unsaved changes: run after any unsaved change to the document."
      }
    },
    {
      "row": "read_back_mismatch",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--id",
        "EDGE_ROUND",
        "--name",
        "ROUND_A"
      ],
      "expected": {
        "exit": 1,
        "code": "E_VERIFY_FAILED",
        "summary": "While the tool waits before its read-back, --tamper renames the feature again in Creo."
      }
    }
  ]
}
