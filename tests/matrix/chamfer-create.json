{
  "command": "chamfer create",
  "rows": [
    {
      "row": "normal",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "TOP_CHAMFER",
        "--distance",
        "0.5mm",
        "--distance-name",
        "CHM",
        "--edges",
        "BASE/end:outer-edges"
      ],
      "expected": {
        "exit": 0,
        "summary": "On a part with the extrude BASE: chamfers the outer edges of BASE's end face 0.5 x 0.5 mm; the distance is named CHM."
      }
    },
    {
      "row": "empty",
      "applies": false,
      "reason": "Creating always gives one feature."
    },
    {
      "row": "invalid_input",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "TOP_CHAMFER",
        "--distance",
        "0.5",
        "--edges",
        "BASE/end:outer-edges"
      ],
      "expected": {
        "exit": 2,
        "code": "E_USAGE",
        "summary": "A bare number: the distance needs a unit."
      }
    },
    {
      "row": "not_found",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "TOP_CHAMFER",
        "--distance",
        "0.5mm",
        "--edges",
        "edge:999999"
      ],
      "expected": {
        "exit": 3,
        "code": "E_NOT_FOUND",
        "summary": "The model has no edge 999999."
      }
    },
    {
      "row": "ambiguous",
      "applies": true,
      "arguments": [
        "--name",
        "TOP_CHAMFER",
        "--distance",
        "0.5mm",
        "--distance-name",
        "CHM",
        "--edges",
        "BASE/end:outer-edges"
      ],
      "expected": {
        "exit": 2,
        "code": "E_AMBIGUOUS",
        "summary": "Two Creo sessions are running and the call names neither."
      }
    },
    {
      "row": "conflict",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "TOP_CHAMFER",
        "--distance",
        "0.5mm",
        "--distance-name",
        "CHM",
        "--edges",
        "BASE/end:outer-edges"
      ],
      "expected": {
        "exit": 6,
        "code": "E_CONFLICT",
        "summary": "A feature named TOP_CHAMFER exists: the preview blocks it."
      }
    },
    {
      "row": "no_scope",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "TOP_CHAMFER",
        "--distance",
        "0.5mm",
        "--distance-name",
        "CHM",
        "--edges",
        "BASE/end:outer-edges"
      ],
      "expected": {
        "exit": 4,
        "code": "E_FORBIDDEN",
        "summary": "Run with a scope file that does not cover the document."
      }
    },
    {
      "row": "busy",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "TOP_CHAMFER",
        "--distance",
        "0.5mm",
        "--distance-name",
        "CHM",
        "--edges",
        "BASE/end:outer-edges"
      ],
      "expected": {
        "exit": 7,
        "code": "E_BUSY",
        "summary": "Creo's main thread is running another request."
      }
    },
    {
      "row": "dialog",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "TOP_CHAMFER",
        "--distance",
        "0.5mm",
        "--distance-name",
        "CHM",
        "--edges",
        "BASE/end:outer-edges"
      ],
      "expected": {
        "exit": 9,
        "code": "E_HUMAN_REQUIRED",
        "summary": "A modal dialog (File > Options) is open in Creo."
      }
    },
    {
      "row": "disconnect",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "TOP_CHAMFER",
        "--distance",
        "0.5mm",
        "--distance-name",
        "CHM",
        "--edges",
        "BASE/end:outer-edges"
      ],
      "expected": {
        "exit": 8,
        "code": "E_OUTCOME_UNKNOWN"
      },
      "unrunnable": "The pipe to the host component cannot be cut on demand at the moment of a call; driver tests D06 and D21 cover this case."
    },
    {
      "row": "unsaved",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "TOP_CHAMFER",
        "--distance",
        "0.5mm",
        "--distance-name",
        "CHM",
        "--edges",
        "BASE/end:outer-edges"
      ],
      "expected": {
        "exit": 0,
        "summary": "Works the same on a document with unsaved changes; the new feature stays unsaved until doc save."
      }
    },
    {
      "row": "read_back_mismatch",
      "applies": true,
      "arguments": [
        "--session",
        "{session}",
        "--doc",
        "{doc}",
        "--name",
        "TOP_CHAMFER",
        "--distance",
        "0.5mm",
        "--distance-name",
        "CHM",
        "--edges",
        "BASE/end:outer-edges"
      ],
      "expected": {
        "exit": 1,
        "code": "E_VERIFY_FAILED",
        "summary": "While the tool waits before its read-back, --tamper sets CHM to another value in Creo."
      }
    }
  ]
}
